{% load static %}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <meta name="google-site-verification" content="bLr30UeuE-mStQrJ_qntqE6OLyZy0we6VLam8FwemFQ" />
    <meta name="facebook-domain-verification" content="53ebjeemf7m73j28gm4yua3nkhyctb" />
    
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-124HX1CKVM"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      
      gtag('config', 'G-124HX1CKVM');
      gtag('config', 'AW-4924359601');
    </script>

    <title>{% block title %}Software de Gestión para Restaurantes Ecuador | Pa'Arriba{% endblock %}</title>

    <meta name="description" content="Controla costos, inventario y ventas de tu restaurante desde $19.99/mes. Facturación electrónica SRI incluida. Software para asaderos, cafeterías y almuerzos en Ecuador.">
    <meta name="keywords" content="transformación digital, emprendedores, negocios, estrategia digital, rentabilidad, crecimiento empresarial, soluciones pymes, Pa’Arriba">
    <link rel="canonical" href="https://pa-arriba.com{{ request.path }}" />

    <meta property="og:title" content="Software de Gestión para Restaurantes Ecuador | Pa'Arriba" />
    <meta property="og:description" content="Controla costos, inventario y ventas de tu restaurante desde $19.99/mes. Facturación electrónica SRI incluida. Software para asaderos, cafeterías y almuerzos en Ecuador." />
    <meta property="og:image" content="https://pa-arriba.com{% static 'core/social_share_pa_arriba.jpg' %}" />
    <meta property="og:url" content="https://pa-arriba.com{{ request.path }}" />
    <meta property="og:type" content="website" />
    <link rel="icon" href="{% static 'core/favicon_solid.png' %}" type="image/png">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600;700;900&display=swap">
    <link rel="stylesheet" href="{% static 'core/style.css' %}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <script src="https://cdn.tailwindcss.com"></script>

    {% include 'core/meta_pixel.html' %} {# Meta Pixel #}
    {% include 'product_schema.html' %} {# Schema.org JSON-LD #}

    {% block extra_head %}{% endblock %} {# Para CSS o meta tags específicos de una página #}
</head>
<body>
    {% block content %}
    {# El contenido único de cada página irá aquí #}
    {% endblock %}

    <script src="https://cdn.jsdelivr.net/npm/tsparticles@2.12.0/tsparticles.bundle.min.js"></script>

    <audio id="bulbSound" src="{% static 'core/light_switch_on.mp3' %}" preload="auto"></audio>
    <audio id="spaceMusic" src="{% static 'core/space_ambience.wav' %}" preload="auto" loop></audio>

    <script src="{% static 'core/script.js' %}"></script> {# Nuestro JavaScript refactorizado #}
    {% block extra_js %}{% endblock %} {# Para JS específico de una página #}
    {% include 'core/footer_section.html' %} {# ¡NUEVO: Footer global aquí! #}

</body>
</html>
